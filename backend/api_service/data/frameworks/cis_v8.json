   "description": null,
   "category": "CIS 7 — Vulnerability Management",
   "criticality": "critical",
   "control_type": "technical"
  },
  {
   "control_ref": "7.1",
   "title": "Establish and maintain a vulnerability management process",
   "description": "A documented vulnerability management process for enterprise assets is established and maintained.",
   "category": "CIS 7 — Vulnerability Management",
   "criticality": "critical",
   "control_type": "technical",
   "checks": [
    {
     "key": "scan_config.continuous_schedule",
     "required": true,
     "rationale": "An active recurring scan schedule is the operating process."
    }
   ]
  },
  {
   "control_ref": "7.5",
   "title": "Perform automated vulnerability scans of internal assets",
   "description": "Automated vulnerability scans of internal enterprise assets are performed on a quarterly or more frequent basis.",
   "category": "CIS 7 — Vulnerability Management",
   "criticality": "critical",
   "control_type": "technical",
   "checks": [
    {
     "key": "vs.scan_recency.quarterly",
     "required": true,
     "rationale": "Quarterly completed scans are the direct 7.5 artifact."
    },
    {
     "key": "vs.scan_coverage.90d",
     "required": true,
     "rationale": "Coverage proves scans reach enterprise assets broadly."
    }
   ]
  },
  {
   "control_ref": "7.7",
   "title": "Remediate detected vulnerabilities",
   "description": "Detected vulnerabilities are remediated through processes and tooling on a monthly or more frequent basis.",
   "category": "CIS 7 — Vulnerability Management",
   "criticality": "critical",
   "control_type": "technical",
   "checks": [
    {
     "key": "vs.no_overdue_highs",
     "required": true,
     "rationale": "No findings past SLA evidences the remediation cadence."
    },
    {
     "key": "vs.rescan_after_remediation",
     "required": false,
     "rationale": "Rescan verification confirms remediation effectiveness."
    }
   ]
  },
