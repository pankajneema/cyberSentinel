# CyberSentinel frontend — example environment. Copy to .env and fill real values.
# Only VITE_-prefixed vars are exposed to the browser; never put secrets here
# beyond the Supabase anon (public) key, which is safe to ship.

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
