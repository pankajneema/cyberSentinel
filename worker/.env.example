# CyberSentinel scan-execution worker — local defaults. Copy to .env (gitignored).

# App
APP_ENV=dev
LOG_LEVEL=info

# RabbitMQ (required). Queues are derived per service/priority by the engine
# (asm.high/medium/low, vs.*, ca.*, reporting) — no per-queue env needed.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Postgres (Go uses pgx DSN; Python uses postgresql+asyncpg for the same DB)
POSTGRESQL_URL=postgres://postgres:postgres@localhost:5432/cybersentinel?sslmode=disable

# Redis (concurrency slots + live task state + cancel/lease + task_events pub/sub)
REDISADDR=localhost:6379
REDISPASS=
REDISDB=0

# Local consumer worker-pool bound (goroutines). Global caps are the per-service slots below.
JOB_MAX_CONCURRENCY=8

# Per-service global concurrency (Redis slots:{service}). ASM/VS run heavy tools; CA is lighter.
ASM_MAX_CONCURRENCY=2
VS_MAX_CONCURRENCY=2
CA_MAX_CONCURRENCY=3

# Task lifecycle
TASK_TIMEOUT_SECONDS=900
TASK_LEASE_TTL_SECONDS=120
TASK_HEARTBEAT_SECONDS=30

# VS just-in-time credential fetch (authenticated scans)
CORE_API_URL=http://api_service:8000
CONTROL_PLANE_TOKEN=
