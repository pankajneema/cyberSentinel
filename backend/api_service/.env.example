# CyberSentinel API — example environment. Copy to .env and fill real values.
# NEVER commit the real .env (see root .gitignore).

# -------- Database (PostgreSQL — source of truth for app data) --------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/cybersentinel

# -------- Supabase (identity provider — owns ALL auth) --------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET           # Settings → API → JWT Settings
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY      # only for admin/invite actions

# -------- Redis --------
REDIS_URL=redis://localhost:6379

# -------- RabbitMQ --------
RABBITMQ_URL=amqp://USER:PASSWORD@localhost:5672/

# -------- CORS (comma-separated allow-list; never use * with credentials) --------
CORS_ORIGINS_URL=http://localhost:8080,http://localhost:3000

# -------- Email / SMTP (no secret defaults in code) --------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=YOUR_SENDER@example.com
SMTP_PASSWORD=YOUR_ROTATED_APP_PASSWORD
CONTACT_EMAIL=YOUR_CONTACT_INBOX@example.com

# -------- App --------
DEBUG=false

# NOTE: The legacy SECRET_KEY / JWT_SECRET are being removed — Supabase signs
# and verifies all tokens now. Do not reintroduce hardcoded signing secrets.

# --- Vulnerability Scanning (VS) module ---
# Shared secret gating the internal worker->API channel (credential materialize).
# MUST match CONTROL_PLANE_TOKEN configured on the Go workers. Fail-closed if unset.
CONTROL_PLANE_TOKEN=
# Fernet key (or passphrase) encrypting authenticated-scan credentials at rest.
VS_CRED_KEY=
# Optional NVD API key for higher CVE-feed sync throughput (KEV/EPSS need no key).
NVD_API_KEY=
# Hours between VS CVE-intel syncs (default 20).
VS_CVE_SYNC_HOURS=20
